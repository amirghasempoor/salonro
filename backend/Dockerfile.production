# ---------------------------------------------------------------------------
# Stage 1: Composer dependencies (no scripts - no .env needed at build time)
# ---------------------------------------------------------------------------
FROM docker.arvancloud.ir/composer:2 AS builder

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --no-interaction \
    --prefer-dist

COPY . .

RUN composer dump-autoload --optimize --classmap-authoritative --no-dev --no-scripts

# ---------------------------------------------------------------------------
# Stage 2: FrankenPHP runtime - a single Caddy-based process that replaces
# the old nginx + php-fpm pair.
#
# FrankenPHP embeds a thread-safe (ZTS) PHP build inside Caddy, so extensions
# can't be reused from the regular php:*-fpm-alpine image (that build is
# NTS) - they're compiled here, against this image's own PHP.
#
# Verify this tag still exists for your PHP version before building:
# https://hub.docker.com/r/dunglas/frankenphp/tags
# ---------------------------------------------------------------------------
FROM dunglas/frankenphp:1-php8.5-alpine AS application

RUN apk add --no-cache \
        bash \
        curl \
        libpng \
        libjpeg-turbo \
        freetype \
        libwebp \
        libxml2 \
        libzip \
        libpq \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libwebp-dev \
        libxml2-dev \
        libzip-dev \
        libpq-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_pgsql gd zip pcntl \
    && apk del .build-deps

COPY docker/opcache-production.ini /usr/local/etc/php/conf.d/zz-opcache.ini

WORKDIR /var/www/salonro

COPY --from=builder /app /var/www/salonro

COPY docker/entrypoint-production.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && chown -R www-data:www-data storage bootstrap/cache \
    && find storage bootstrap/cache -type d -exec chmod 775 {} + \
    && find storage bootstrap/cache -type f -exec chmod 664 {} +

EXPOSE 80 443 443/udp

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sS -H "Host: api.salonro.ir" -o /dev/null http://127.0.0.1/ || exit 1

ENTRYPOINT ["entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
